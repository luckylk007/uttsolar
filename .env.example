# ==========================================
# UTTsolar.in — Environment Configuration
# ==========================================

# Public Site URL
NEXT_PUBLIC_SITE_URL=https://uttsolar.in

# ------------------------------------------
# Resend Email Configuration (for Leads on Gmail)
# Get your API key at: https://resend.com/api-keys
# ------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here

# Your Gmail or Company inbox where all leads should be sent
LEAD_NOTIFICATION_EMAIL=info@uttsolar.in

# From Sender Email
# For free onboarding testing, use: UTTsolar Leads <onboarding@resend.dev>
# After verifying your domain on Resend, use: UTTsolar Leads <leads@uttsolar.in>
LEAD_FROM_EMAIL=UTTsolar Leads <onboarding@resend.dev>
